# .env.example

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_PAPER=true
APCA_EXECUTION_ENABLED=false
APCA_DATA_FEED=iex
QI_MAX_POSITION_ALLOCATION=0.25
QI_MAX_ORDER_NOTIONAL=2500
QI_MAX_ORDER_SHARES=10
QI_POST_CLOSE_DELAY_MINUTES=5
QI_TRADING_PERSISTENCE=postgres
DATABASE_URL=
QI_SYMBOL=SPY
QI_SMA_WINDOW=200
QI_AUDIT_DIR=/var/lib/quant-intelligence/alpaca_audit
QI_RECONCILIATION_INTERVAL_SECONDS=60
QI_SERVICE_LOCK_NAME=quant-intelligence:alpaca-paper
# EDGAR risk-factor signals (research only; free SEC data + local Ollama)
SEC_USER_AGENT="Atelier AI Labs research nmagera07@gmail.com"
QI_EDGAR_CACHE_DIR=data/edgar
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120
QI_SIGNAL_REPLAY_LOG=data/signals/replay.jsonl
